{
  // pi (pi.dev) provider config — drop this content into ~/.pi/agent/models.json
  // or copy it to <dir>/models.json and set PI_CODING_AGENT_DIR=<dir>.
  // Requires pi >= node 22.
  "providers": {
    "proxytool": {
      "baseUrl": "http://127.0.0.1:8180/v1",
      "api": "openai-completions",
      "apiKey": "not-needed",
      "compat": {
        // local inference servers don't speak OpenAI's developer role or
        // reasoning_effort param — keep the dialect plain.
        "supportsDeveloperRole": false,
        "supportsReasoningEffort": false
      },
      "models": [
        {
          "id": "qwen-gguf",
          "name": "Qwen GGUF via proxytool",
          "input": ["text"],
          "contextWindow": 16384,
          "maxTokens": 8192
        },
        {
          "id": "qwen-mlx",
          "name": "Qwen MLX via proxytool",
          "input": ["text"],
          "contextWindow": 16384,
          "maxTokens": 8192
        },
        {
          "id": "qwen2.5-0.5b-instruct-gguf",
          "name": "Qwen2.5-0.5B-Instruct GGUF via proxytool",
          "input": ["text"],
          "contextWindow": 8192,
          "maxTokens": 2048
        },
        {
          // oMLX serves the model directory name as the id (see dev/RIG.md).
          "id": "qwen2.5-0.5b-4bit",
          "name": "Qwen2.5-0.5B-Instruct-4bit via oMLX",
          "input": ["text"],
          "contextWindow": 4096,
          "maxTokens": 2048
        }
      ]
    }
  }
}
