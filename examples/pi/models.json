{
  // pi (pi.dev) provider config — drop this content into ~/.pi/agent/models.json
  // or copy it to <dir>/models.json and set PI_CODING_AGENT_DIR=<dir>.
  // Requires pi >= node 22.
  "providers": {
    "proxytool": {
      "baseUrl": "http://127.0.0.1:8180/v1",
      "api": "openai-completions",
      "apiKey": "not-needed",
      "compat": {
        // local inference servers don't speak OpenAI's developer role or
        // reasoning_effort param — keep the dialect plain.
        "supportsDeveloperRole": false,
        "supportsReasoningEffort": false
      },
      "models": [
        {
          "id": "qwen-gguf",
          "name": "Qwen GGUF via proxytool",
          "input": ["text"],
          "contextWindow": 16384,
          "maxTokens": 8192
        },
        {
          "id": "qwen-mlx",
          "name": "Qwen MLX via proxytool",
          "input": ["text"],
          "contextWindow": 16384,
          "maxTokens": 8192
        },
        {
          "id": "phi-4-mini",
          "name": "Phi-4-mini Q5_K_M via proxytool",
          "input": ["text"],
          "contextWindow": 16384,
          "maxTokens": 4096
        },
        {
          // oMLX serves the model directory name as the id (see docs/RIG.md).
          "id": "phi-4-mini-mlx",
          "name": "Phi-4-mini 4bit via oMLX",
          "input": ["text"],
          "contextWindow": 16384,
          "maxTokens": 4096
        }
      ]
    }
  }
}
