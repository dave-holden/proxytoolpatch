{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",

  "provider": {
    "proxytool": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "proxytool",
      "options": {
        "apiKey": "not-needed",
        // keep the /v1 suffix: @ai-sdk/openai-compatible appends
        // "chat/completions" to baseURL, and /v1 is what engages the
        // tool-call repair route instead of the catch-all passthrough.
        "baseURL": "http://127.0.0.1:8180/v1"
      },
      "models": {
        "qwen-gguf": {
          "name": "Qwen2.5-Coder-14B (GGUF)"
        },
        "qwen-mlx": {
          "name": "Qwen2.5-Coder-14B (MLX)"
        },
        "qwen2.5-0.5b-instruct-gguf": {
          "name": "Qwen2.5-0.5B-Instruct GGUF (q4_k_m)"
        },
        "qwen2.5-0.5b-4bit": {
          "name": "Qwen2.5-0.5B-Instruct-4bit (MLX, oMLX)"
        }
      }
    }
  },

  // ids match the llama-swap model keys (or the mode-2 routing entries)
  "model": "proxytool/qwen-gguf",
  "small_model": "proxytool/qwen2.5-0.5b-instruct-gguf",
  "mcp": {},
  "plugin": []
}
