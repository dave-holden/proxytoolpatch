# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info/

# Virtual environments
.venv/
.idea/
.pytest_cache/
.ruff_cache/
.coverage
.nox/

# Local-only working files (deliberately not part of the repo)
PLAN.md
RELEASE.md
Running.md
Obsolete/
history.txt
oc-stderr.log

# Agent/assistant tool state
.claude/
.cursor/
.aider/
.codex/
.continue/
.freebuff

# Untracked local developer tooling (documented in dev/DEVELOPMENT.md:
# git hooks, dev rig, test matrix — nothing in the repo depends on them)
scripts/

# Local config copies (the tracked, canonical configs live in examples/)
config/*

# Local capture images / build artifacts pulled in from external builds
apps/proxytool/public/assets/images/proxytool-with-bg.webp
packages/toolpatch/public/assets/images/toolpatch-with-bg.webp
public/assets/images/proxytoolpatch-with-bg.webp
public/assets/images/proxytoolpatch.png

# Ad-hoc probe/debug scripts, if ever recreated locally
debug_hermes.py
probe_extract.py
probe_stream.py
probe_test_const.py

# Coverage artifacts
htmlcov/
coverage.xml

# OS junk
**/.DS_Store

# Catch-all for stray logs
*.log

# Ignored work zones (temp outputs, scenarios, local dev docs, drafts)
SENARIOS/
docs/
tmp/
dev/
